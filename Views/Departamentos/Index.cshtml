@model IEnumerable<MiniDocs.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Departamentos</h1>
        <p class="text-muted mb-0">Administra las áreas disponibles para organizar documentos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo departamento</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Creado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var departamento in Model)
                {
                    <tr>
                        <td class="fw-semibold">@departamento.Nombre</td>
                        <td>@(departamento.Descripcion ?? "—")</td>
                        <td>
                            <span class="badge @(departamento.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(departamento.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>@departamento.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@departamento.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="ToggleActive" asp-route-id="@departamento.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    @(departamento.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
