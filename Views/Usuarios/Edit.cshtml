@model MiniDocs.Models.UsuarioEditViewModel
@{ ViewData["Title"] = "Editar usuario"; }
<h1>Editar usuario</h1><p class="text-muted">Actualiza sus datos y permisos.</p>
<form asp-action="Edit" method="post" class="mt-4 col-lg-8">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="NombreCompleto" class="form-label"></label><input asp-for="NombreCompleto" class="form-control" /><span asp-validation-for="NombreCompleto" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label">Correo electrónico</label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Rol" class="form-label"></label><select asp-for="Rol" asp-items="ViewBag.Roles" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="DepartamentoId" class="form-label">Departamento</label><select asp-for="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-select"><option value="">Sin departamento</option></select></div>
    <div class="form-check mb-3"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Cuenta activa</label></div>
    <button class="btn btn-primary" type="submit">Guardar cambios</button><a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
