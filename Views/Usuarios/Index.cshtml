@model IEnumerable<MiniDocs.Models.ApplicationUser>
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Usuarios";
    var roles = ViewBag.Roles as Dictionary<string, string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Usuarios</h1>
        <p class="text-muted mb-0">Administra las cuentas y permisos de MiniDocs.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Departamento</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td class="fw-semibold">@usuario.NombreCompleto</td>
                    <td>@usuario.Email</td>
                    <td>@(roles.TryGetValue(usuario.Id, out var rol) ? rol : "Sin rol")</td>
                    <td>@(usuario.Departamento?.Nombre ?? "—")</td>
                    <td><span class="badge @(usuario.Activo ? "text-bg-success" : "text-bg-secondary")">@(usuario.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end">
                        @if (User.IsInRole("SuperAdministrador") || roles[usuario.Id] != "SuperAdministrador")
                        {
                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <form asp-action="ToggleActive" asp-route-id="@usuario.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(usuario.Activo ? "Desactivar" : "Activar")</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Cuenta protegida</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
