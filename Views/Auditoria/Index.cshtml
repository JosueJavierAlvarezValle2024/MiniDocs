@model IEnumerable<MiniDocs.Models.AuditoriaDocumento>
@{ ViewData["Title"] = "Auditoría"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1>Auditoría de documentos</h1><p class="text-muted mb-0">Últimas acciones registradas.</p></div>
</div>
<div class="table-responsive"><table class="table table-striped align-middle">
    <thead><tr><th>Fecha</th><th>Acción</th><th>Documento</th><th>Usuario</th></tr></thead>
    <tbody>@foreach (var registro in Model) { <tr><td>@registro.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><span class="badge text-bg-secondary">@registro.Accion</span></td><td>@registro.Documento?.Titulo</td><td>@registro.Usuario?.Email</td></tr> }</tbody>
</table></div>
