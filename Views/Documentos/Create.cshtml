@model MiniDocs.Models.DocumentoCreateViewModel
@{ ViewData["Title"] = "Nuevo documento"; }
<h1>Nuevo documento</h1><p class="text-muted">Carga un archivo y asígnalo a un departamento.</p>
<form asp-action="Create" method="post" enctype="multipart/form-data" class="mt-4 col-lg-8">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" /><span asp-validation-for="Titulo" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="DepartamentoId" class="form-label"></label><select asp-for="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-select"><option value="">Selecciona un departamento</option></select><span asp-validation-for="DepartamentoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Archivo" class="form-label"></label><input asp-for="Archivo" class="form-control" type="file" /><div class="form-text">PDF, Word, Excel, texto o imágenes. Máximo 10 MB.</div><span asp-validation-for="Archivo" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Guardar documento</button><a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
