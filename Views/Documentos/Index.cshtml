@model IEnumerable<MiniDocs.Models.Documento>
@{ ViewData["Title"] = "Documentos"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1>Documentos</h1><p class="text-muted mb-0">Consulta y administra tus archivos.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo documento</a></div>
@if (TempData["SuccessMessage"] is string message) { <div class="alert alert-success">@message</div> }
<form method="get" class="row g-2 mb-4"><div class="col-md-5"><input name="busqueda" value="@ViewBag.Busqueda" class="form-control" placeholder="Buscar por título" /></div><div class="col-md-4"><select name="departamentoId" asp-items="ViewBag.Departamentos" class="form-select"><option value="">Todos los departamentos</option></select></div><div class="col-md-3"><button class="btn btn-outline-primary w-100" type="submit">Filtrar</button></div></form>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Título</th><th>Departamento</th><th>Propietario</th><th>Archivo</th><th>Fecha</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var documento in Model)
{
    <tr><td class="fw-semibold">@documento.Titulo<br /><small class="text-muted">@(documento.Descripcion ?? "")</small></td><td>@documento.Departamento?.Nombre</td><td>@documento.Usuario?.NombreCompleto</td><td>@documento.NombreArchivoOriginal<br /><small class="text-muted">@(documento.TamanoBytes / 1024) KB</small></td><td>@documento.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@documento.Id" class="btn btn-sm btn-outline-secondary">Editar</a> <a asp-action="Download" asp-route-id="@documento.Id" class="btn btn-sm btn-outline-primary">Descargar</a><form asp-action="Delete" asp-route-id="@documento.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button></form></td></tr>
}
</tbody></table></div></div>
